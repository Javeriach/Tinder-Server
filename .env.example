# ---- Database / Auth ----
MONGODB_CONNECTION_STRING=your-mongodb-atlas-uri
JWT_TOKEN=your-jwt-secret
PORT=7777

# ---- CORS ----
# Comma-separated list of allowed browser origins (your deployed frontend).
# localhost dev origins are always allowed.
CORS_ORIGINS=https://your-frontend.vercel.app

# ---- Email ----
# Transport is chosen automatically: Gmail SMTP if GMAIL_USER + GMAIL_APP_PASSWORD
# are set, else Resend if RESEND_API_KEY is set, else email is silently disabled.

# --- Option A: Gmail SMTP (free, ~500/day, delivers to ANY recipient, no domain) ---
# Requires 2-Step Verification on the Google account, then an App Password:
#   https://myaccount.google.com/apppasswords
GMAIL_USER=javeriakanwal383@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Display name shown to recipients (optional, defaults to "Tinder").
GMAIL_FROM_NAME=Tinder

# --- Option B: Resend ---
# API key from https://resend.com/api-keys.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
# Sender address. Must be on a Resend-verified domain.
# `onboarding@resend.dev` works without a domain but only delivers to the account owner's email.
EMAIL_FROM=onboarding@resend.dev

# Recipient for admin-alert emails / fallback recipient.
EMAIL_TO=javeriakanwal383@gmail.com

# ---- Payments (Stripe) ----
# Secret key from https://dashboard.stripe.com/apikeys (use the test key while developing).
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
# Signing secret for the webhook endpoint (starts with whsec_).
# From the Stripe dashboard, or printed by `stripe listen` during local testing.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET
# Lowercase ISO currency code. Use "usd" unless your Stripe account has PKR enabled.
PAYMENT_CURRENCY=usd
# Base URL of the frontend; Stripe redirects here after checkout.
FRONTEND_URL=http://localhost:5173

# ---- Media (Cloudinary) ----
CLOUD_NAME=
CLOUDNARY_API_KEY=
CLOUDNARY_API_SECRET=
